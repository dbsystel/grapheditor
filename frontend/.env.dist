VITE_BACKEND_PORT=4999
E2E_NEO4J_HOST=
E2E_NEO4J_USER=
E2E_NEO4J_PASSWORD=
E2E_NEO4J_DATABASE=
# must be the same as E2E_GUI_PORT in the root .env file
E2E_VITE_BACKEND_PORT=5000

# Theme configuration
# Controls the theme at dev/build time (via VITE_THEME in vite.config.ts).
# Leave empty for whitelabel (default), set to "db" for Deutsche Bahn theme.
VITE_THEME=
# Required only for VITE_THEME=db — obtain from DB Marketingportal
ASSET_PASSWORD=
ASSET_INIT_VECTOR=
