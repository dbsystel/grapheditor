{
	"name": "grapheditor-frontend",
	"version": "0.0.0",
	"private": true,
	"author": "Mihajlo Lazar, Stefan Seliger",
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"engines": {
		"node": "24.18.0",
		"npm": "11.16.0"
	},
	"scripts": {
		"create-component": "node scripts/create-component.js",
		"dev": "vite",
		"build": "tsc && vite build",
		"test": "npm run test:unit",
		"test:unit": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:report": "playwright show-report",
		"test:e2e:update-browsers": "npx playwright install",
		"preview": "vite preview --port 8080",
		"lint": "eslint src --ext .ts --ext .tsx",
		"lint:fix": "eslint src --ext .ts --ext .tsx --fix",
		"prettier:fix": "prettier --write src",
		"dependencies:check": "ncu --peer",
		"dependencies:update": "ncu --peer --upgrade",
		"generate-icon-font": "node ./scripts/generate-icon-font.js",
		"generate-build-info": "node ./scripts/generate-build-info.js",
		"setup": "npm install && allow-scripts",
		"setup:ci": "npm ci && allow-scripts"
	},
	"dependencies": {
		"@db-ux/react-core-components": "5.6.1",
		"@floating-ui/react": "0.27.20",
		"@sigma/edge-curve": "3.1.0",
		"@sigma/node-border": "3.0.0",
		"@sigma/node-square": "3.0.0",
		"@sigma/utils": "3.0.0",
		"axios": "1.20.0",
		"clsx": "2.1.1",
		"graphology": "0.26.0",
		"graphology-layout": "0.6.1",
		"graphology-layout-force": "0.2.4",
		"graphology-layout-forceatlas2": "0.10.1",
		"graphology-layout-noverlap": "0.4.2",
		"i18next": "26.4.2",
		"i18next-browser-languagedetector": "8.2.1",
		"i18next-http-backend": "4.0.2",
		"lucide-react": "1.49.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-hook-form": "7.89.0",
		"react-i18next": "17.0.15",
		"react-markdown": "10.1.0",
		"react-router-dom": "7.18.4",
		"seedrandom": "3.0.5",
		"sigma": "3.0.3",
		"source-map-js": "1.2.1",
		"yup": "1.7.1",
		"zustand": "5.0.15"
	},
	"devDependencies": {
		"@cyclonedx/cyclonedx-npm": "6.0.1",
		"@db-ux/icon-font-tools": "0.3.6",
		"@eslint/eslintrc": "3.3.7",
		"@eslint/js": "9.39.4",
		"@lavamoat/allow-scripts": "5.1.0",
		"@lavamoat/preinstall-always-fail": "3.0.0",
		"@playwright/test": "1.63.0",
		"@types/babel__core": "^7.20.5",
		"@types/hoist-non-react-statics": "3.3.7",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/seedrandom": "3.0.8",
		"@types/ws": "8.18.2",
		"@typescript-eslint/eslint-plugin": "8.71.0",
		"@typescript-eslint/parser": "8.71.0",
		"@vitejs/plugin-react": "6.0.3",
		"@vitest/browser": "5.0.2",
		"@vitest/browser-playwright": "5.0.2",
		"@vitest/coverage-v8": "5.0.2",
		"autoprefixer": "10.6.1",
		"dotenv": "18.0.4",
		"esbuild": "^0.28.2",
		"eslint": "9.39.5",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-prettier": "5.5.6",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-simple-import-sort": "14.0.0",
		"globals": "17.12.0",
		"license-compliance": "4.0.0",
		"lucide-static": "1.49.0",
		"msw": "3.0.0",
		"npm-check-updates": "23.1.0",
		"playwright": "1.63.0",
		"playwright-chromium": "1.63.0",
		"postcss": "8.5.28",
		"prettier": "3.9.9",
		"sass": "1.105.1",
		"typescript": "6.0.3",
		"vite": "8.3.1",
		"vite-plugin-checker": "0.14.5",
		"vite-plugin-svgr": "5.2.0",
		"vitest": "5.0.2",
		"vitest-browser-react": "2.3.0"
	},
	"overrides": {
		"license-compliance": {
			"joi": "18.2.9"
		}
	},
	"editor.codeActionsOnSave": {
		"source.fixAll.eslint": true
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"lavamoat": {
		"allowScripts": {
			"@lavamoat/preinstall-always-fail": false,
			"@cyclonedx/cyclonedx-npm>libxmljs2#0.37.0": true,
			"@db-ux/icon-font-tools>svgtofont>ttf2woff2#8.0.1": true,
			"msw#3.0.0": true,
			"playwright-chromium#1.63.0": true,
			"sass>@parcel/watcher#2.6.0": true,
			"@db-ux/icon-font-tools>esbuild#0.25.11": true,
			"esbuild#0.28.2": true
		}
	}
}
